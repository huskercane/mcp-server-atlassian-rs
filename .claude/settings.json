{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/check-release-tag.sh\"",
            "timeout": 10,
            "statusMessage": "Checking release tag against Cargo.toml"
          }
        ]
      }
    ]
  }
}
